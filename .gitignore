.DS_Store
# Windows "Mark of the Web" Alternate Data Stream sidecars
*:Zone.Identifier
.cursor
.vscode
.mov
.mp4
.env
# Any *.env file (e.g. bot-accounts.env for the k8s bot fleet, #2035) — a bare
# `.env` matches only that exact name, so this catches local credential env-files
# kept in-tree by mistake. Creds should live OUTSIDE the tree; this is a backstop.
*.env
#for jet brains products
.idea/
target/
dioxus-ui/dist/
# Developer-local config overrides (see scripts/config.local.js.example).
dioxus-ui/scripts/config.local.js

# Short-lived dev WebTransport cert + private key + hash. Regenerated by
# scripts/regen-dev-cert.sh on every `make e2e-up` / `make e2e-cert`. Cert is
# capped at 13 days because Chromium rejects `serverCertificateHashes` entries
# for any cert with more than 14 days of validity.
#
# `localhost.cert-sha256.txt` is the base64 DER-SHA-256 of that cert — the value
# the E2E helper injects as `window.__VC_WT_CERT_HASHES__`. Untracked because it
# fingerprints a machine-local 13-day artifact (issue #2159); the regen script
# rewrites it whenever it is missing or does not match the cert.
actix-api/certs/localhost.pem
actix-api/certs/localhost.key
actix-api/certs/localhost.cert-sha256.txt
helm/digital-ocean-secret
helm/global/us-east/grafana/secret.yaml
helm-videocall-deployment/

