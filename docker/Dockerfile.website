# Interim: the leptos website is the one image still built via Dockerfile
# (Stage 3 of the nix migration turns it into a release.nix derivation like
# the rest — see docs/nix-architecture.md). The builder uses the repo's native
# Nix entry points (no flakes).
FROM nixos/nix:2.33.2 AS builder

ENV NIX_CONFIG="experimental-features = nix-command"

WORKDIR /app

COPY default.nix shell.nix release.nix ./
COPY nix/ nix/

# Downloads all tools from the Nix binary cache (~seconds).
# This layer is cached by Docker as long as the nix/ pins are unchanged.
RUN nix-shell default.nix -A shells.leptos-website --run true

COPY leptos-website/ leptos-website/

RUN nix-shell default.nix -A shells.leptos-website --run "\
    cd leptos-website && \
    npm install && \
    cargo leptos build --release"

# ---------------------------------------------------------------------------
FROM debian:bookworm-slim

COPY --from=builder /app/leptos-website/target/release/leptos_website /app/
COPY --from=builder /app/leptos-website/target/site /app/site
COPY --from=builder /app/leptos-website/Cargo.toml /app/

WORKDIR /app
ENV RUST_LOG="info"
ENV LEPTOS_SITE_ADDR="0.0.0.0:8080"
ENV LEPTOS_SITE_ROOT="site"
EXPOSE 8080

CMD ["/app/leptos_website"]
