// ┏┓╻+╻ ╱┏┳┓┏┓┏┳┓┏┓╻
// ┃┃┃┃┗━┓╹┃╹┣┫┃┃┃┣┫┃   Read the manpage:
// ╹┗┛╹╱ ╹ ╹ ╹╹╹ ╹╹╹┗┛  $ man nixtamal-manifest
version "1.2.0"
// All inputs are imported at Nix evaluation time (default.nix / shell.nix /
// release.nix), so they must be fetched at eval via builtins.fetchTarball.
default-fetch-time eval
inputs {
	nixpkgs {
		archive {
			url "https://github.com/NixOS/nixpkgs/archive/{{fresh_value}}.tar.gz"
		}
		hash algorithm=SHA-256
		fresh-cmd {
			$ git ls-remote "https://github.com/NixOS/nixpkgs.git" --refs "refs/heads/nixos-unstable"
			| cut -f1
		}
	}
	// Older nixpkgs tree that still carries cargo-leptos 0.2.42 — it builds
	// leptos 0.8 and bundles wasm-bindgen-cli-support 0.2.100 (the crate pins
	// wasm-bindgen = "=0.2.100" to match); newer trees ship 0.3.x with a
	// different bindgen. Frozen: this pin must never move on refresh; bumping
	// it is a deliberate manifest edit.
	nixpkgs-leptos frozen=#true {
		archive {
			url "https://github.com/NixOS/nixpkgs/archive/{{fresh_value}}.tar.gz"
		}
		hash algorithm=SHA-256
		fresh-cmd {
			$ echo "ee09932cedcef15aaf476f9343d1dea2cb77e261"
		}
	}
	// Pinned Rust toolchains (stable 1.93.1, musl + wasm targets) via the
	// oxalica overlay.
	rust-overlay {
		archive {
			url "https://github.com/oxalica/rust-overlay/archive/{{fresh_value}}.tar.gz"
		}
		hash algorithm=SHA-256
		fresh-cmd {
			$ git ls-remote "https://github.com/oxalica/rust-overlay.git" --refs "refs/heads/master"
			| cut -f1
		}
	}
	// Cargo dependency caching: deps-only derivations shared across builds
	crane {
		archive {
			url "https://github.com/ipetkov/crane/archive/{{fresh_value}}.tar.gz"
		}
		hash algorithm=SHA-256
		fresh-cmd {
			$ git ls-remote "https://github.com/ipetkov/crane.git" --refs "refs/heads/master"
			| cut -f1
		}
	}
}
